{% extends 'base.html.twig' %}

{% block title %}Products{% endblock %}

{% block body %}
    <section class="container page-section">
        <div class="page-heading">
            <div>
                <p class="eyebrow">The collection</p>
                <h1>Products</h1>
            </div>
            <p class="muted">{{ products|length }} item{% if products|length != 1 %}s{% endif %}</p>
        </div>

        {% if products is empty %}
            <div class="empty-state"><p>No products found.</p></div>
        {% else %}
        <ul class="product-grid">
            {% for product in products %}
                <li class="product-card">
                    <a class="product-card-link" href="{{ path('app_product_show', {id: product.id}) }}">
                        <div class="product-image"><span>{{ product.name|first|upper }}</span></div>
                    </a>
                    <div class="product-card-body">
                        <a class="product-card-link" href="{{ path('app_product_show', {id: product.id}) }}">
                            <div class="product-card-title"><h2>{{ product.name }}</h2><span class="arrow">↗</span></div>
                            <p class="price">{{ (product.price / 100)|number_format(2, '.', ',') }} €</p>
                            <p class="stock">{{ product.stock }} in stock</p>
                        </a>
                        {% if app.user %}
                            <form action="{{ path('app_cart_item_add', {id: product.id}) }}" method="post">
                                <input type="hidden" name="_token" value="{{ csrf_token('add_to_cart') }}">
                                <button class="button button-primary product-add-button" type="submit">Add to cart <span aria-hidden="true">→</span></button>
                            </form>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
        {% endif %}
    </section>
{% endblock %}
