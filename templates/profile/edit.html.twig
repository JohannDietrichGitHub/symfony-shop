{% extends 'base.html.twig' %}

{% block title %}Your profile{% endblock %}

{% block body %}
    <section class="container page-section profile-page">
        <div class="page-heading">
            <div>
                <p class="eyebrow">Account</p>
                <h1>Your profile</h1>
                <p class="muted profile-heading-copy">Manage your personal details and communication preferences.</p>
            </div>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        <div class="profile-card">
            <p class="profile-email"><strong>Account email</strong><br>{{ user.email }}</p>

            {{ form_start(profileForm) }}
                <div class="profile-form-grid">
                    {{ form_row(profileForm.firstName) }}
                    {{ form_row(profileForm.lastName) }}
                </div>
                <div class="profile-phone-grid">
                    <div class="phone-input-group">
                        {{ form_widget(profileForm.phoneCountryCode, {attr: {'aria-label': 'Phone country code'}}) }}
                        {{ form_row(profileForm.phone, {label: 'Phone number'}) }}
                    </div>
                </div>
                {{ form_row(profileForm.marketingEmailOptIn) }}
                <button class="button button-primary" type="submit">Save changes</button>
            {{ form_end(profileForm) }}
        </div>

        <div class="profile-card profile-address-link">
            <div>
                <p class="eyebrow">Delivery</p>
                <h2>Saved addresses</h2>
                <p class="muted">Manage the addresses you use for delivery and checkout.</p>
            </div>
            <a class="button button-primary" href="{{ path('app_address_index') }}">Manage addresses</a>
        </div>
    </section>
{% endblock %}
