<header class="site-header">
    <div class="container header-inner">
        <a class="brand" href="{{ path('app_home') }}" aria-label="AlsaceMarket home">
            <span class="brand-mark">A</span>
            <span>AlsaceMarket</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
            <a href="{{ path('app_home') }}">Home</a>
            <a href="{{ path('app_products_list') }}">Products</a>
        {% if app.user %}
            {% set cartItemCount = app.user.cart ? app.user.cart.cartItems|reduce((total, item) => total + item.quantity, 0) : 0 %}
            <a href="{{ path('app_cart_show') }}">Cart{% if cartItemCount > 0 %} ({{ cartItemCount }}){% endif %}</a>
            <a href="{{ path('app_profile') }}">Profile</a>
            <a class="nav-action" href="{{ path('app_logout') }}">Logout</a>
        {% else %}
            <a href="{{ path('app_login') }}">Sign in</a>
            <a class="nav-action" href="{{ path('app_register') }}">Sign up</a>
        {% endif %}
        </nav>
    </div>
</header>
