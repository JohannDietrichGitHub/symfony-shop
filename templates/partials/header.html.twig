<header class="site-header">
    <div class="container header-inner">
        <a class="brand" href="{{ path('app_home') }}" aria-label="My Shop home">
            <span class="brand-mark">M</span>
            <span>My Shop</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
            <a href="{{ path('app_home') }}">Home</a>
            <a href="{{ path('app_products_list') }}">Products</a>
        {% if app.user %}
            <a class="nav-action" href="{{ path('app_logout') }}">Logout</a>
        {% else %}
            <a href="{{ path('app_login') }}">Sign in</a>
            <a class="nav-action" href="{{ path('app_register') }}">Sign up</a>
        {% endif %}
        </nav>
    </div>
</header>
