<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}AlsaceMarket{% endblock %}</title>
    {{ importmap('app') }}
</head>
<body>
{% include 'partials/header.html.twig' %}

<main class="site-main">
    {% for message in app.flashes('error') %}
        <div class="container flash-message" role="alert">{{ message }}</div>
    {% endfor %}
    {% block body %}{% endblock %}
</main>

{% include 'partials/footer.html.twig' %}
</body>
</html>
